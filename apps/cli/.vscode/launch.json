{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI (tsx)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--loader", "tsx"],
      "program": "${workspaceFolder}/src/index.ts",
      "cwd": "${workspaceFolder}",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    }
  ],
  "workspaceFolder": "${workspaceFolder}/apps/cli"
}
