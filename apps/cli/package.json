{
    "name": "@doci/cli",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsx src/index.ts",
        "dev_extract": "tsx src/index.ts -- extract",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run --exclude **/ExecutableSmoke.spec.ts",
        "test:smoke": "vitest run ExecutableSmoke",
        "build:win": "bun build --compile --outfile=release/win/doci-cli-win.exe src/index.ts  --external:*.wasm && bun ./scripts/copy-wasm.ts win",
        "build:linux": "bun build --compile --outfile=release/linux/doci-cli-linux src/index.ts  --external:*.wasm && bun ./scripts/copy-wasm.ts linux",
        "build:mac": "bun build --compile --outfile=release/mac/doci-cli-macos src/index.ts  --external:*.wasm && bun ./scripts/copy-wasm.ts mac"
    },
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "@types/bun": "^1.3.4",
        "tsdown": "^0.16.6",
        "typescript": "^5.6.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "commander": "^14.0.2",
        "tree-sitter-javascript": "^0.23.1",
        "tree-sitter-typescript": "^0.23.2",
        "tsx": "^4.20.6",
        "web-tree-sitter": "^0.25.0"
    }
}