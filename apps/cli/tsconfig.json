{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": "./src",
    "module": "ESNext",
    "allowImportingTsExtensions": false,
    "target": "ES2022",
    "strict": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@doci/shared": ["../../libs/shared"]
    }
  },
  "include": ["src"]
}
