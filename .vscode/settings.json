{
  "cSpell.words": ["Doci", "titlebar", "unmaximize"],
  "editor.rulers": [100],
  "workbench.colorCustomizations": {
    "editorRuler.foreground": "#504e7b"
  },
  "azureFunctions.deploySubpath": "azure",
  "azureFunctions.postDeployTask": "npm install (functions)",
  "azureFunctions.projectLanguage": "TypeScript",
  "azureFunctions.projectRuntime": "~4",
  "debug.internalConsoleOptions": "neverOpen",
  "azureFunctions.projectLanguageModel": 4,
  "azureFunctions.preDeployTask": "npm prune (functions)",

  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false, // if you want nested groups collapsed by default
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, nx.json, tsconfig*.json, tsconfig.*.json, CNAME, eslint*.json, eslint.*.mjs, .eslintrc*.json, jest.*.js, jest.*.ts, .prettierrc*, .prettierrc.*, .gitignore, .prettierignore, .dockerignore, Dockerfile* "
    // and you can add more patterns for other configs
  }
}
